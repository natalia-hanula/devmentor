# Połączenie z PostgreSQL. Te same dane działają dla Postgresa z Homebrew
# (rola utworzona ręcznie, zob. README) i dla `docker compose up -d`.
DATABASE_URL=postgresql://devmentor:devmentor@localhost:5432/devmentor

# Opcjonalnie: testy integracyjne bez Dockera (zamiast testcontainers).
# UWAGA: setup testów czyści schemat tej bazy — nigdy nie wskazuj bazy z danymi.
# INTEGRATION_DATABASE_URL=postgresql://devmentor:devmentor@localhost:5432/devmentor_integration

# Gdzie działa aplikacja: local | test | staging | production. Brak wpisu = production (najostrzejsze reguły).
APP_ENV=local

# Poczta: outbox (skrzynka deweloperska w pamięci, podgląd dla operatora) | noop (nic nie wysyła).
# Brak wpisu = outbox przy APP_ENV=local i test, noop przy staging i production (staging może jawnie
# ustawić outbox). Outbox przy APP_ENV=production blokuje start (pokazuje operatorowi linki
# weryfikacji i resetu wszystkich kont).
# MAIL_ADAPTER=outbox

# Czy przed aplikacją stoi zaufany reverse proxy dopisujący adres klienta na koniec x-forwarded-for:
# true | false. Brak wpisu = false — nagłówek jest wtedy ignorowany (klient może go podrobić), a limiter
# nie rozróżnia klientów po IP. Ustaw true tylko, gdy ruch dochodzi do aplikacji wyłącznie przez proxy.
# TRUST_PROXY=false

# Adres aplikacji (linki w e-mailach, callback OAuth).
APP_BASE_URL=http://localhost:3000

# Sekret podpisujący sesje (min. 32 bajty). `npm run setup` generuje go sam; ręcznie:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Zmiana sekretu wylogowuje wszystkich użytkowników.
# AUTH_JWT_SECRET=
