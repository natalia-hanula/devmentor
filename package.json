{
  "name": "devmentor",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "setup": "node --experimental-strip-types scripts/setup.ts",
    "dev": "npm run dev -w @devmentor/app",
    "build": "npm run build -w @devmentor/app",
    "start": "npm run start -w @devmentor/app",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && tsc -p scripts && npm run typecheck --workspaces --if-present",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "db:up": "docker compose up -d --wait",
    "db:migrate": "npm run migration:up -w @devmentor/db",
    "db:migration:create": "npm run migration:create -w @devmentor/db --",
    "db:migration:list": "npm run migration:list -w @devmentor/db",
    "test:integration": "npm run build && vitest run --config tests/integration/vitest.config.ts",
    "storybook": "npm run storybook -w @devmentor/ui",
    "build-storybook": "npm run build-storybook -w @devmentor/ui",
    "test:storybook": "npm run test:storybook -w @devmentor/ui",
    "lint:tokens": "npm run lint:tokens -w @devmentor/ui"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.0.5",
    "agent-browser": "0.39.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "jsdom": "^30.1.3",
    "pg": "^8.23.1",
    "testcontainers": "^12.2.1",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "type": "module",
  "engines": {
    "node": ">=22.17"
  }
}
