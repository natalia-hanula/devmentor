{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    // Instalator działa przez type stripping w Node (`node --experimental-strip-types`): importy muszą
    // mieć rozszerzenie `.ts`, składnia musi być w pełni usuwalna, a importy samych typów — jawnie `import type`.
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true
  },
  "include": ["**/*.ts"],
  // CLI operatora (`tsx`, importuje `@devmentor/core`) ma osobną konfigurację: `tsconfig.operator.json`.
  "exclude": ["create-operator.ts", "operator/**", "test/operator/**"]
}
